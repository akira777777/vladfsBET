{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "NODE_ENV",
    "REAL_MONEY_ENABLED",
    "TRUSTED_PROXY_CIDRS",
    "TRUSTED_PROXY_PROVIDER",
    "RATE_LIMIT_USE_REDIS",
    "API_HOST",
    "API_MAX_CONNECTIONS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "api/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:validate": {
      "cache": false
    }
  }
}
