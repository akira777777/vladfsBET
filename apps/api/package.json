{
  "name": "@vladfsbet/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/serverless.ts --bundle --platform=node --target=node20 --format=esm --external:@prisma/client --external:@prisma/client/* --external:redis --external:@redis/* --outfile=api/index.js && esbuild src/fetch.ts --bundle --platform=node --target=node20 --format=esm --external:@prisma/client --external:@prisma/client/* --external:redis --external:@redis/* --outfile=api/fetch.js",
    "start": "tsx src/index.ts",
    "test": "node ../../scripts/run-vitest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@vladfsbet/config": "*",
    "@vladfsbet/db": "*",
    "@vladfsbet/service-games": "*",
    "@vladfsbet/service-kyc": "*",
    "@vladfsbet/service-notifications": "*",
    "@vladfsbet/service-payments": "*",
    "@vladfsbet/service-sports": "*",
    "@vladfsbet/types": "*",
    "@vladfsbet/utils": "*",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "ipaddr.js": "^2.5.0",
    "redis": "^5.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
