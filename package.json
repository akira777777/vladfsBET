{
  "name": "@vladfsbet/root",
  "version": "1.0.0",
  "private": true,
  "description": "VladfsBET - Full Production Online Casino Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "tsc --noEmit",
    "db:validate": "npm run db:validate -w @vladfsbet/db",
    "db:generate": "npm run db:generate -w @vladfsbet/db",
    "db:migrate": "npm run db:migrate -w @vladfsbet/db",
    "db:seed": "npm run db:seed -w @vladfsbet/db",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "api:dev": "npm run dev -w @vladfsbet/api",
    "web:dev": "npm run dev -w @vladfsbet/web"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
